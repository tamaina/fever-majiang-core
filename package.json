{
  "name": "@aqz/fever-majiang-core",
  "version": "0.1.0",
  "description": "Fever Mahjong three-player game engine (fork of kobalab/majiang-core)",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build && npm run test:types && vitest run",
    "test:legacy": "mocha -u tdd --extension js",
    "test:legacy:cover": "nyc -r lcov -r text npm run test:legacy",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:types": "tsc --noEmit --strict --module Node16 --target ES2022 test/types-smoke.cts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamaina/fever-majiang-core.git"
  },
  "keywords": [
    "麻雀",
    "電脳麻将"
  ],
  "author": "Satoshi Kobayashi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tamaina/fever-majiang-core/issues"
  },
  "homepage": "https://github.com/tamaina/fever-majiang-core#readme",
  "devDependencies": {
    "mocha": "^11.7.1",
    "nyc": "^17.1.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "files": [
    "dist"
  ],
  "private": true,
  "types": "dist/index.d.ts"
}
